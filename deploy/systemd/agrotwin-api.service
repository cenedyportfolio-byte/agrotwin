[Unit]
Description=AgroTwin API (FastAPI) and its processing workers
After=network-online.target docker.service ollama.service
Wants=network-online.target

[Service]
User=agrotwin
Group=agrotwin
WorkingDirectory=/opt/agrotwin/backend
EnvironmentFile=/etc/agrotwin/agrotwin.env
# One worker process: the processing queues and the sign-in throttle live in
# it. Only nginx talks to it (127.0.0.1).
ExecStart=/opt/agrotwin/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
