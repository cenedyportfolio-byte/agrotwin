# AgroTwin server settings — copy to /etc/agrotwin/agrotwin.env (readable by
# root and the agrotwin user only: it holds the mail password) and edit.
# Read by both services (agrotwin-api, agrotwin-web) at start.

# Where the database, uploaded photos and maps live (a big disk: plan
# 10–15 GB per flight). Every data folder follows it.
AGROTWIN_DATA_DIR=/srv/agrotwin/data

# The address farmers open (links in e-mails).
AGROTWIN_PUBLIC_URL=https://agrotwin.example.edu

# Behind https: the sign-in cookie is then never sent in clear.
AGROTWIN_COOKIE_SECURE=true
# AGROTWIN_SESSION_DAYS=60

# Detailed maps: OpenDroneMap in Docker after every quick map.
AGROTWIN_ODM_ENABLED=true
AGROTWIN_ODM_IMAGE=opendronemap/odm:gpu
AGROTWIN_ODM_GPUS=true
# AGROTWIN_ODM_TIMEOUT_HOURS=12
# AGROTWIN_ODM_BUILD_3D=true

# The assistant: an offline model served by Ollama on this server.
AGROTWIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGROTWIN_OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# Optional: e-mail farmers when their map is ready.
# AGROTWIN_SMTP_HOST=smtp.example.edu
# AGROTWIN_SMTP_PORT=587
# AGROTWIN_SMTP_USER=agrotwin
# AGROTWIN_SMTP_PASSWORD=change-me
# AGROTWIN_SMTP_FROM=AgroTwin <agrotwin@example.edu>

# Web app (Next.js).
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
